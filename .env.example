# .env.example — env keys for dynamic-action-map. Copy to .env and fill in values.
# Regenerated by sync_projects.py --regen-env-examples; key metadata lives in the
# meta-project's credential_catalog.yaml. [central] secrets are filled automatically
# from the meta .env by --setup / --reseed-credentials.

# Google Sheets service account JSON (full JSON string, unquoted)
# Reused from meta-project .env. Share the Sheet with the SA email before first sync.
# [central — seeded from the meta .env]
GOOGLE_SHEETS_CREDENTIALS_PASSWORD=

# The Google Sheet that drives this map. Paste the long ID from the Sheet URL.  [config — per deployment]
GOOGLE_SHEET_ID=

# Sheet tab to read map rows from  [config — per deployment]
GOOGLE_SHEET_TAB=

# Fallback tab when GOOGLE_SHEET_TAB is absent  [config — per deployment]
GOOGLE_SHEET_DEFAULT_TAB=

# Required only when running with --push (i.e. on Civis).
# Fine-grained PAT scoped to dynamic-action-map only, with Contents: Read & Write.
# In Civis, store as a credential named DYNAMIC_ACTION_MAP_GITHUB_PAT —
# the platform exposes it as DYNAMIC_ACTION_MAP_GITHUB_PAT_PASSWORD automatically.
# [project secret — set per deployment]
DYNAMIC_ACTION_MAP_GITHUB_PAT_PASSWORD=

# Target GitHub repo for --push (owner/name)  [config — per deployment]
GITHUB_REPO=
